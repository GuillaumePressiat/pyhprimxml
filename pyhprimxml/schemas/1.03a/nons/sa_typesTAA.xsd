<?xml version="1.0" encoding="UTF-8"?>
<!-- auteur : eric DUFOUR -->

<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">

   <xsd:complexType name="typeInterventionBase">
      <xsd:sequence>
         <xsd:element name="identifiant" type="typeIdentifiant"/>
         <xsd:element name="debut" type="typeDateHeureOptionnelle" minOccurs="0"/>
         <xsd:element name="fin" type="typeDateHeureOptionnelle" minOccurs="0"/>
         <xsd:element name="uniteFonctionnelle" type="typeCode10Libelle35" minOccurs="0"/>
      </xsd:sequence>
   </xsd:complexType>
   <xsd:complexType name="typeIntervention">
      <xsd:complexContent>
         <xsd:extension base="typeInterventionBase">
            <xsd:sequence>
               <xsd:element name="participants" type="typeParticipants" minOccurs="0"/>
               <xsd:element name="libelle" type="texte80" minOccurs="0"/>
               <xsd:element name="demande" type="typeDemande" minOccurs="0"/>
               <xsd:element name="piecesJointes" type="typePiecesJointes" minOccurs="0"/>
               <xsd:element name="commentaire" type="commentaire" minOccurs="0"/>
            </xsd:sequence>
         </xsd:extension>
      </xsd:complexContent>
   </xsd:complexType>

   <xsd:simpleType name="ccam">
      <xsd:restriction base="xsd:string">
         <xsd:pattern value="[A-Z]{4}[0-9]{3}"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:complexType name="typeModificateurs">
      <xsd:sequence>
         <xsd:element name="modificateur" type="typeModificateur" minOccurs="0" maxOccurs="10"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="typeModificateur">
      <xsd:simpleContent>
         <xsd:extension base="nom1Majuscule">
            <xsd:attribute name="statut" type="attrModificateur" default="nft"/>
         </xsd:extension>
      </xsd:simpleContent>
   </xsd:complexType>
 
    <xsd:complexType name="typeParticipants">
       <xsd:sequence>
          <xsd:element name="participant" type="typeParticipant" maxOccurs="unbounded"/>
       </xsd:sequence>
    </xsd:complexType>
   <xsd:complexType name="typeParticipant">
      <xsd:choice>
         <xsd:element name="medecin" type="typeProfessionnelSante"/>
         <xsd:element name="uniteFonctionnelle" type="typeCode10Libelle35"/>
      </xsd:choice>
   </xsd:complexType>
   <xsd:complexType name="typeDemande">
      <xsd:sequence>
         <xsd:element name="identifiant" type="typeIdentifiant" minOccurs="0"/>
         <xsd:element name="datePrescription" type="typeDateHeureOptionnelle"/>
         <xsd:element name="uniteFonctionnelle" type="typeCode10Libelle35" minOccurs="0"/>
         <xsd:element name="medecin" type="typeMedecin" minOccurs="0"/>
         <xsd:element name="libelle" type="texte80" minOccurs="0"/>
         <xsd:element name="commentaire" type="commentaire" minOccurs="0"/>
      </xsd:sequence>
         <xsd:attribute name="originePrescription" type="attrOriginePrescription" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="typeCodeLPP">
      <xsd:simpleContent>
         <xsd:extension base="nombre13">
            <xsd:attribute name="portee" type="attrPortee" default="n"/>
         </xsd:extension>
      </xsd:simpleContent>
   </xsd:complexType>

   <xsd:complexType name="typeNabm">
      <xsd:sequence>
         <xsd:element name="code" type="xsd:integer" maxOccurs="unbounded"/>
      </xsd:sequence>
   </xsd:complexType>
   
   
   <xsd:simpleType name="attrModificateur">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="ft"/>
         <xsd:enumeration value="nft"/>
      </xsd:restriction>
   </xsd:simpleType>
   <xsd:simpleType name="attrIndicateurParcoursSoins">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="traitant"/>
         <xsd:enumeration value="nouveau"/>
         <xsd:enumeration value="oriente"/>
         <xsd:enumeration value="direct"/>
         <xsd:enumeration value="urgence"/>
         <xsd:enumeration value="horsResidence"/>
         <xsd:enumeration value="remplace"/>
         <xsd:enumeration value="horsParcours"/>
         
         <xsd:enumeration value="medecinZoneDefic"/>
         <xsd:enumeration value="medecinPrimoInst"/>
         <xsd:enumeration value="medecinNonTrait"/>
         
         <xsd:enumeration value="militaire"/>
         <xsd:enumeration value="exclusionMedical"/>

      </xsd:restriction>
   </xsd:simpleType>

   
      <xsd:simpleType name="attrOriginePrescription">
         <xsd:restriction base="xsd:string">
            <xsd:enumeration value="parcoursSoin"/>
            <xsd:enumeration value="autreSituation"/>
            <xsd:enumeration value="horsParcoursSoin"/>
            <xsd:enumeration value="medecinTraitant"/>
         </xsd:restriction>
      </xsd:simpleType>

   <xsd:simpleType name="attrValide">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="oui"/>
         <xsd:enumeration value="non"/>
         <xsd:enumeration value="att"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrPortee">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="n"/>
         <xsd:enumeration value="l"/>
      </xsd:restriction>
   </xsd:simpleType>


</xsd:schema>
