<?xml version="1.0" encoding="UTF-8"?>
<!-- auteur : Eric DUFOUR -->
<xsd:schema targetNamespace="http://www.hprim.org/hprimXML" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.hprim.org/hprimXML" elementFormDefault="qualified" attributeFormDefault="unqualified">
   <xsd:include schemaLocation="sa_enteteMessage.xsd"/>
   <xsd:include schemaLocation="sa_patient_light.xsd"/>
   <xsd:include schemaLocation="sa_venue_light.xsd"/>
   <xsd:include schemaLocation="sa_pieceJointe.xsd"/>
   <xsd:include schemaLocation="sa_pmsi.xsd"/>
   <xsd:include schemaLocation="sa_typesTAA.xsd"/>
   <xsd:element name="evenementsServeurEtatsPatient" type="typeEvenementsServeurEtatsPatient" />
   
   <xsd:complexType name="typeEvenementsServeurEtatsPatient">
      <xsd:sequence>
         <xsd:element name="enteteMessage" type="typeEnteteMessage"/>
         <xsd:element name="patient" type="typePatientLight"/>
         <xsd:element name="venue" type="typeVenueLight" minOccurs="0"/>
         <xsd:choice>
            <xsd:element name="intervention" type="typeIntervention"/>
            <xsd:element name="dateObservation" type="typeDateHeureOptionnelle"/>
            <xsd:element name="recueil" type="typeRecueilEtat"/>
         </xsd:choice>
         <xsd:element name="Diagnostics" type="typeDiagnosticsEtat" minOccurs="0"/>
         <xsd:element name="dependances" type="typeDependancesEtat" minOccurs="0"/>
         <xsd:element name="igs2" type="typeIgs2Etat" minOccurs="0"/>
         <xsd:element name="naissance" type="typeNaissance" minOccurs="0"/>
         <xsd:element name="actesReeducation" type="typeActesReeducationEtat" minOccurs="0"/>
         <xsd:element name="commentaire" type="commentaire" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="version" type="numeroVersion" use="required"/>
      <xsd:attribute name="acquittementAttendu" type="ouiNon" default="non"/>
      <xsd:attribute name="identifiantAttendu" type="ouiNon" default="non"/>
      <xsd:attribute name="realise" type="ouiNon" default="oui"/>
   </xsd:complexType>
   <xsd:complexType name="typeDiagnosticsEtat">
      <xsd:sequence>
         <xsd:element name="diagnostic" type="typeDiagnosticEtat" maxOccurs="unbounded"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="typeDiagnosticEtat">
      <xsd:sequence>
         <xsd:element name="dateAction" type="xsd:dateTime" minOccurs="0"/>
         <xsd:element name="acteur" type="typeProfessionnelSante" minOccurs="0"/>
         <xsd:element name="identifiant" type="typeIdentifiantEtat" minOccurs="0"/>
         <xsd:element name="codeCim10" type="typeDiagnosticSimple" minOccurs="0"/>
         <xsd:element name="codesLibres" type="typeCodesLibres" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="action" type="actionMiseAJour" use="required"/>
      <xsd:attribute name="type" type="attrTypeDiagnosticEtat" />
  </xsd:complexType>
  
   <xsd:complexType name="typeDependancesEtat">
      <xsd:sequence>
         <xsd:element name="dateAction" type="xsd:dateTime" minOccurs="0"/>
         <xsd:element name="acteur" type="typeProfessionnelSante" minOccurs="0"/>
         <xsd:element name="identifiant" type="typeIdentifiantEtat" minOccurs="0"/>
         <xsd:element name="habillage" type="degre"/>
         <xsd:element name="deplacement" type="degre"/>
         <xsd:element name="alimentation" type="degre"/>
         <xsd:element name="continence" type="degre"/>
         <xsd:element name="comportement" type="degre"/>
         <xsd:element name="relation" type="degre"/>
      </xsd:sequence>
      <xsd:attribute name="action" type="actionMiseAJour" use="required"/>
   </xsd:complexType>
   <xsd:complexType name="typeIgs2Etat">
      <xsd:sequence>
         <xsd:element name="dateAction" type="xsd:dateTime" minOccurs="0"/>
         <xsd:element name="acteur" type="typeProfessionnelSante" minOccurs="0"/>
         <xsd:element name="identifiant" type="typeIdentifiantEtat" minOccurs="0"/>
         <xsd:element name="valeurGlobale" type="typeIgs2VG" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="action" type="actionMiseAJour" use="required"/>
      <xsd:attribute name="modeAdmission" type="attrModeAdmission"/>
      <xsd:attribute name="maladieChronique" type="attrMaladieChronique"/>
      <xsd:attribute name="scoreGlasgow" type="attrScoreGlasgow"/>
      <xsd:attribute name="age" type="attrAge"/>
      <xsd:attribute name="tensionArterielleSystolique" type="attrTensionArterielleSystolique"/>
      <xsd:attribute name="frequenceCardiaque" type="attrFrequenceCardiaque"/>
      <xsd:attribute name="temperature" type="attrTemperature"/>
      <xsd:attribute name="paO2_FIO2" type="attrPaO2_FIO2"/>
      <xsd:attribute name="diurese" type="attrDiurese"/>
      <xsd:attribute name="ureeSanguine" type="attrUreeSanguine"/>
      <xsd:attribute name="leucocytes" type="attrLeucocytes"/>
      <xsd:attribute name="kaliemie" type="attrKaliemie"/>
      <xsd:attribute name="natremie" type="attrNatremie"/>
      <xsd:attribute name="HCO3" type="attrHCO3"/>
      <xsd:attribute name="bilirubine" type="attrBilirubine"/>
   </xsd:complexType>
   
   <xsd:complexType name="typeRecueilEtat">
      <xsd:sequence>
         <xsd:element name="identifiant" type="typeIdentifiantEtat"/>
         <xsd:element name="date" type="xsd:date"/>
         <xsd:element name="heure" type="xsd:time" minOccurs="0"/>
         <xsd:element name="uniteFonctionnelle" type="typeCode10Libelle35"/>
         <xsd:element name="medecin" type="typeProfessionnelSante" minOccurs="0"/>
      </xsd:sequence>
   </xsd:complexType>


   <xsd:complexType name="typeNaissance">
      <xsd:sequence>
         <xsd:element name="dateAction" type="xsd:dateTime" minOccurs="0"/>
         <xsd:element name="acteur" type="typeProfessionnelSante" minOccurs="0"/>
         <xsd:element name="identifiant" type="typeIdentifiantEtat" minOccurs="0"/>
         <xsd:element name="poidsNouveauNe" type="nombre5" minOccurs="0"/>
         <xsd:element name="ageGestationnel" type="nombre2" minOccurs="0"/>
         <xsd:element name="dateDerniereRegle" type="xsd:date" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="action" type="actionMiseAJour" use="required"/>
   </xsd:complexType>
   
   <xsd:complexType name="typeActesReeducationEtat">
      <xsd:sequence>
      	<xsd:element name="acteReeducation" type="typeActeReeducationEtat" maxOccurs="unbounded"/>
      </xsd:sequence>
   </xsd:complexType>
 
   <xsd:complexType name="typeActeReeducationEtat">
      <xsd:sequence>
         <xsd:element name="dateAction" type="xsd:dateTime" minOccurs="0"/>
         <xsd:element name="acteur" type="typeProfessionnelSante" minOccurs="0"/>
         <xsd:element name="identifiant" type="typeIdentifiantEtat" minOccurs="0"/>
         <xsd:element name="codeCDARR" type="acteReeducationSimple"/>
         <xsd:element name="quantite" type="nombre5" />
      </xsd:sequence>
      <xsd:attribute name="action" type="actionMiseAJour" use="required"/>
      <xsd:attribute name="typeIntervenant" type="attrTypeIntervenantCdarr" use="required"/>
  </xsd:complexType>
 

   <xsd:simpleType name="typeIgs2VG">
      <xsd:restriction base="xsd:integer">
         <xsd:minInclusive value="0"/>
         <xsd:maxInclusive value="194"/>
      </xsd:restriction>
   </xsd:simpleType>




   <xsd:simpleType name="attrModeAdmission">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="chirUrgente"/>
         <xsd:enumeration value="medecine"/>
         <xsd:enumeration value="chirProgrammee"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrMaladieChronique">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="aucune"/>
         <xsd:enumeration value="cancerMetastatique"/>
         <xsd:enumeration value="maladieHematologiqueMaligne"/>
         <xsd:enumeration value="sida"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrScoreGlasgow">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA6"/>
         <xsd:enumeration value="6A8"/>
         <xsd:enumeration value="9A10"/>
         <xsd:enumeration value="11A13"/>
         <xsd:enumeration value="14A18"/>
      </xsd:restriction>
   </xsd:simpleType>
   <xsd:simpleType name="attrAge">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA40"/>
         <xsd:enumeration value="40A59"/>
         <xsd:enumeration value="60A69"/>
         <xsd:enumeration value="70A74"/>
         <xsd:enumeration value="75A79"/>
         <xsd:enumeration value="superieurEgalA80"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrTensionArterielleSystolique">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA70"/>
         <xsd:enumeration value="70A99"/>
         <xsd:enumeration value="100A199"/>
         <xsd:enumeration value="superieurEgalA200"/>
      </xsd:restriction>
   </xsd:simpleType>
   
   <xsd:simpleType name="attrFrequenceCardiaque">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA40"/>
         <xsd:enumeration value="40A69"/>
         <xsd:enumeration value="70A119"/>
         <xsd:enumeration value="120A159"/>
         <xsd:enumeration value="superieurEgalA160"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrTemperature">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA39"/>
         <xsd:enumeration value="superieurEgalA39"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrPaO2_FIO2">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="rien"/>
         <xsd:enumeration value="inferieurA100"/>
         <xsd:enumeration value="100A199"/>
         <xsd:enumeration value="superieurEgalA200"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrDiurese">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA0,5"/>
         <xsd:enumeration value="0,5A0,999"/>
         <xsd:enumeration value="superieurA1"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrUreeSanguine">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA10"/>
         <xsd:enumeration value="10A29,9"/>
         <xsd:enumeration value="superieurA30"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrLeucocytes">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA1"/>
         <xsd:enumeration value="1A19,9"/>
         <xsd:enumeration value="superieurEgalA20"/>
      </xsd:restriction>
   </xsd:simpleType>
   <xsd:simpleType name="attrKaliemie">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA3"/>
         <xsd:enumeration value="3A4,9"/>
         <xsd:enumeration value="superieurEgalA5"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrNatremie">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA125"/>
         <xsd:enumeration value="125A144"/>
         <xsd:enumeration value="superieurEgalA145"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrHCO3">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA15"/>
         <xsd:enumeration value="15A19"/>
         <xsd:enumeration value="superieurEgalA20"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrBilirubine">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="inferieurA68,4"/>
         <xsd:enumeration value="68,4A102,5"/>
         <xsd:enumeration value="superieurA102,6"/>
      </xsd:restriction>
   </xsd:simpleType>
   

   <xsd:simpleType name="attrTypeDiagnosticEtat">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="fpc"/>
         <xsd:enumeration value="mm"/>
         <xsd:enumeration value="ae"/>
         <xsd:enumeration value="da"/>
         <xsd:enumeration value="dp"/>
         <xsd:enumeration value="dr"/>
         <xsd:enumeration value="ds"/>
         <xsd:enumeration value="dd"/>
      </xsd:restriction>
   </xsd:simpleType>




</xsd:schema>
   
